/* SPDX-License-Identifier: GPL-2.0-or-later
 * Generated by scripts/generate_keymap.py from config/layout.json.
 * Original QMK keymap: Copyright 2020 gtips, modified by aefreedman.
 * Edit layout.json for bindings and the generator/includes for behaviors, then regenerate.
 */
#define ZMK_POINTING_DEFAULT_MOVE_VAL 2000
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define COLEMAK 0
#define QWERTY  1
#define FPS     2
#define SYM     3
#define NUM     4
#define FUNC    5
#define ADJUST  6
#define DJMAX   7
#define MOUSE   8

&mmv_input_listener {
    input-processors = <&pointer_speed>;
};

&lt {
    tapping-term-ms = <200>;
    // A tap must not force the next hold into repeating Backspace/Delete.
    quick-tap-ms = <0>;
    flavor = "tap-preferred";
};

/ {
    pointer_speed: runtime_mouse_speed {
        compatible = "aefreedman,mouse-speed-scaler";
        #input-processor-cells = <0>;
        track-remainders;
    };
    behaviors {
        ms_adjust: mouse_speed_adjust {
            compatible = "aefreedman,mouse-speed";
            #binding-cells = <1>;
        };
        ms_down: mouse_speed_down {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&ms_adjust 0>, <&ms_adjust 2>;
        };
        ms_up: mouse_speed_up {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&ms_adjust 1>, <&ms_adjust 2>;
        };
        tg: thumb_gestures {
            compatible = "aefreedman,thumb-gestures";
            #binding-cells = <1>;
            symbol-layer = <SYM>;
        };
        base_select: base_selection {
            compatible = "aefreedman,base-select";
            #binding-cells = <1>;
        };
        ms_fast: mouse_fast_mode {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&ms_adjust 3>, <&ms_adjust 4>;
        };
        ms_precision: mouse_precision_mode {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&ms_adjust 5>, <&ms_adjust 6>;
        };
    };
    keymap {
        compatible = "zmk,keymap";

        colemak_layer {
            display-name = "Colemak";
            // LEFT                                                      RIGHT
            bindings = <
                &none   &none &none &none &none    &none                                       &none        &none        &none     &none   &none    &none
                &kp ESC &kp Q &kp W &kp F &kp P    &kp B                                       &kp J        &kp L        &kp U     &kp Y   &kp SEMI &kp LALT
                &kp TAB &kp A &kp R &kp S &kp T    &kp G                                       &kp M        &kp N        &kp E     &kp I   &kp O    &kp SQT
                &tg 2   &kp Z &kp X &kp C &kp D    &kp V &none &none      &tog MOUSE &kp RET   &kp K        &kp H        &kp COMMA &kp DOT &kp FSLH &tg 1
                                    &none &kp LGUI &tg 0 &none &none      &none      &kp SPACE &lt NUM BSPC &lt FUNC DEL &none
                &none   &none &none &none &none                                                             &none        &none     &none   &none    &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        base_layer {
            display-name = "QWERTY";
            // LEFT                                                      RIGHT
            bindings = <
                &none   &none &none &none &none    &none                                       &none        &none        &none     &none   &none    &none
                &kp ESC &kp Q &kp W &kp E &kp R    &kp T                                       &kp Y        &kp U        &kp I     &kp O   &kp P    &kp LALT
                &kp TAB &kp A &kp S &kp D &kp F    &kp G                                       &kp H        &kp J        &kp K     &kp L   &kp SEMI &kp SQT
                &tg 2   &kp Z &kp X &kp C &kp V    &kp B &none &none      &tog MOUSE &kp RET   &kp N        &kp M        &kp COMMA &kp DOT &kp FSLH &tg 1
                                    &none &kp LGUI &tg 0 &none &none      &none      &kp SPACE &lt NUM BSPC &lt FUNC DEL &none
                &none   &none &none &none &none                                                             &none        &none     &none   &none    &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fps_layer {
            display-name = "Fps";
            // LEFT                                                                        RIGHT
            bindings = <
                &none                &none  &none  &none  &none    &none                                         &none     &none &none &none &none &none
                &kp ESC              &kp F1 &kp F2 &kp F3 &kp T    &kp I                                         &kp N3    &kp Q &kp W &kp E &kp R &kp N4
                &kp TAB              &kp F4 &kp F5 &kp F6 &kp G    &kp J                                         &kp N2    &kp A &kp S &kp D &kp F &kp B
                &base_select COLEMAK &kp F7 &kp F8 &kp F9 &kp P    &kp M   &none &none      &tog MOUSE &kp RET   &kp N1    &kp Z &kp X &kp C &kp V &kp LCTRL
                                                   &none  &kp LALT &kp TAB &none &none      &none      &kp SPACE &kp LSHFT &kp Y &none
                &none                &none  &none  &none  &none                                                            &none &none &none &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym_layer {
            display-name = "Sym";
            // LEFT                                                                      RIGHT
            bindings = <
                &none     &none &none    &none    &none         &none                                        &none     &none           &none    &none     &none     &none
                &kp TILDE &none &kp EXCL &kp LPAR &kp KP_DIVIDE &kp PIPE                                     &kp UNDER &kp KP_MULTIPLY &kp RPAR &kp DLLR  &none     &trans
                &trans    &none &kp AT   &kp LBRC &kp MINUS     &kp BSLH                                     &kp FSLH  &kp KP_PLUS     &kp RBRC &kp PRCNT &kp COLN  &none
                &trans    &none &kp HASH &kp LBKT &kp GRAVE     &kp SQT  &none &none      &tog MOUSE &kp RET &kp DQT   &kp EQUAL       &kp RBKT &kp AMPS  &kp QMARK &trans
                                         &none    &trans        &trans   &none &none      &none      &none   &trans    &trans          &none
                &none     &none &none    &none    &none                                                                &none           &none    &none     &none     &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        num_layer {
            display-name = "Numbers + navigation";
            // LEFT                                                              RIGHT
            bindings = <
                &none  &none  &none  &none      &none  &none                                         &none        &none     &none    &none     &none  &none
                &trans &trans &kp N7 &kp N8     &kp N9 &trans                                        &kp HOME     &kp PG_UP &kp UP   &kp PG_DN &trans &kp LALT
                &trans &trans &kp N4 &kp N5     &kp N6 &trans                                        &kp END      &kp LEFT  &kp DOWN &kp RIGHT &trans &kp LSHFT
                &trans &trans &kp N1 &kp N2     &kp N3 &trans    &none &none      &tog MOUSE &kp RET &kp INS      &trans    &trans   &trans    &trans &tg 1
                                     &kp KP_DOT &kp N0 &kp LSHFT &none &none      &none      &none   &lt NUM BSPC &trans    &none
                &none  &none  &none  &none      &none                                                             &none     &none    &none     &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        func_layer {
            display-name = "Function + media";
            // LEFT                                                             RIGHT
            bindings = <
                &none   &none   &none   &none   &none   &none                                       &none  &none        &none            &none      &none &none
                &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                                      &none  &kp C_VOL_DN &kp C_VOL_UP     &kp C_MUTE &none &kp LALT
                &kp F7  &kp F8  &kp F9  &kp F10 &kp F11 &kp F12                                     &none  &kp C_PREV   &kp C_PLAY_PAUSE &kp C_NEXT &none &mo ADJUST
                &kp F13 &kp F14 &kp F15 &kp F16 &kp F17 &kp F18 &none &none      &tog MOUSE &kp RET &none  &none        &none            &none      &none &kp LCTRL
                                        &none   &trans  &trans  &none &none      &none      &none   &trans &trans       &none
                &none   &none   &none   &none   &none                                                      &none        &none            &none      &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        adjust_layer {
            display-name = "Adjust";
            // LEFT                                                   RIGHT
            bindings = <
                &none &none &none &none &none  &none                                      &none               &none                &none            &none      &none &none
                &none &none &none &none &none  &none                                      &base_select QWERTY &base_select COLEMAK &base_select FPS &tog DJMAX &none &none
                &none &none &none &none &none  &none                                      &sys_reset          &none                &none            &none      &none &none
                &none &none &none &none &none  &none  &none &none      &tog MOUSE &kp RET &bootloader         &none                &none            &none      &none &none
                                  &none &trans &trans &none &none      &none      &none   &trans              &trans               &none
                &none &none &none &none &none                                                                 &none                &none            &none      &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        djmax_layer {
            display-name = "Djmax";
            // LEFT                                                   RIGHT
            bindings = <
                &none   &none &none &none &none &none                                       &none    &none     &none     &none     &none     &none
                &kp ESC &kp Q &kp W &kp E &kp R &kp T                                       &kp UP   &kp U     &kp I     &kp LSHFT &kp RSHFT &tog DJMAX
                &kp TAB &kp A &kp S &kp D &kp F &kp G                                       &kp DOWN &kp J     &kp K     &kp L     &kp SEMI  &lt NUM BSPC
                &tg 2   &kp Z &kp X &kp C &kp V &kp B &none &none      &tog MOUSE &kp RET   &kp LEFT &kp RIGHT &kp PG_UP &kp PG_DN &kp F1    &kp RET
                                    &none &kp V &kp B &none &none      &none      &kp SPACE &kp N    &kp F2    &none
                &none   &none &none &none &none                                                      &none     &none     &none     &none     &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        mouse_layer {
            display-name = "Mouse (2000 default)";
            // LEFT                                                 RIGHT
            bindings = <
                &none &none &none &none &none &none                                       &none     &none          &none          &none           &none &none
                &none &none &none &none &none &none                                       &none     &kp PG_UP      &mmv MOVE_UP   &kp PG_DN       &none &none
                &none &none &none &none &none &none                                       &none     &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none &none
                &none &none &none &none &none &none &none &none      &tog MOUSE &ms_up    &none     &none          &none          &none           &none &none
                                  &none &none &none &none &none      &ms_down   &mkp LCLK &mkp RCLK &ms_fast       &ms_precision
                &none &none &none &none &none                                                       &none          &none          &none           &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
