#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define COLEMAK 0
#define QWERTY  1
#define FPS     2
#define SYM     3
#define NUM     4
#define FUNC    5
#define ADJUST  6
#define DJMAX   7

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        rd: reviung_dance {
            compatible = "aefreedman,reviung-dance";
            #binding-cells = <1>;
            symbol-layer = <SYM>;
        };
        base_select: reviung_base {
            compatible = "aefreedman,reviung-base";
            #binding-cells = <1>;
        };
    };
    keymap {
        compatible = "zmk,keymap";

        colemak_layer {
            display-name = "Colemak";
            bindings = <
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
                &kp ESC               &kp Q                 &kp W                 &kp F                 &kp P                 &kp B                 &kp J                 &kp L                 &kp U                 &kp Y                 &kp SEMI              &kp LALT
                &kp TAB               &kp A                 &kp R                 &kp S                 &kp T                 &kp G                 &kp M                 &kp N                 &kp E                 &kp I                 &kp O                 &kp SQT
                &rd 2                 &kp Z                 &kp X                 &kp C                 &kp D                 &kp V                 &none                 &none                 &none                 &none                 &kp K                 &kp H                 &kp COMMA             &kp DOT               &kp FSLH              &rd 1
                &none                 &kp LGUI              &rd 0                 &none                 &none                 &none                 &none                 &kp SPACE             &lt NUM BSPC          &lt FUNC DEL
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        base_layer {
            display-name = "QWERTY";
            bindings = <
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
                &kp ESC               &kp Q                 &kp W                 &kp E                 &kp R                 &kp T                 &kp Y                 &kp U                 &kp I                 &kp O                 &kp P                 &kp LALT
                &kp TAB               &kp A                 &kp S                 &kp D                 &kp F                 &kp G                 &kp H                 &kp J                 &kp K                 &kp L                 &kp SEMI              &kp SQT
                &rd 2                 &kp Z                 &kp X                 &kp C                 &kp V                 &kp B                 &none                 &none                 &none                 &none                 &kp N                 &kp M                 &kp COMMA             &kp DOT               &kp FSLH              &rd 1
                &none                 &kp LGUI              &rd 0                 &none                 &none                 &none                 &none                 &kp SPACE             &lt NUM BSPC          &lt FUNC DEL
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fps_layer {
            display-name = "Fps";
            bindings = <
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
                &kp ESC               &kp F1                &kp F2                &kp F3                &kp T                 &kp I                 &kp N3                &kp Q                 &kp W                 &kp E                 &kp R                 &kp N4
                &kp TAB               &kp F4                &kp F5                &kp F6                &kp G                 &kp J                 &kp N2                &kp A                 &kp S                 &kp D                 &kp F                 &kp B
                &base_select COLEMAK  &kp F7                &kp F8                &kp F9                &kp P                 &kp M                 &none                 &none                 &none                 &none                 &kp N1                &kp Z                 &kp X                 &kp C                 &kp V                 &kp LCTRL
                &none                 &kp LALT              &kp TAB               &none                 &none                 &none                 &none                 &kp SPACE             &kp LSHFT             &kp Y
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
                &kp TILDE             &none                 &kp EXCL              &kp LPAR              &kp KP_DIVIDE         &kp PIPE              &kp UNDER             &kp KP_MULTIPLY       &kp RPAR              &kp DLLR              &none                 &trans
                &trans                &none                 &kp AT                &kp LBRC              &kp MINUS             &kp BSLH              &kp FSLH              &kp KP_PLUS           &kp RBRC              &kp PRCNT             &kp COLN              &none
                &trans                &none                 &kp HASH              &kp LBKT              &kp GRAVE             &kp SQT               &none                 &none                 &none                 &none                 &kp DQT               &kp EQUAL             &kp RBKT              &kp AMPS              &kp QMARK             &trans
                &none                 &trans                &trans                &none                 &none                 &none                 &none                 &none                 &trans                &trans
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        num_layer {
            display-name = "Numbers + navigation";
            bindings = <
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
                &trans                &trans                &kp N7                &kp N8                &kp N9                &trans                &kp HOME              &kp PG_UP             &kp UP                &kp PG_DN             &trans                &kp LALT
                &trans                &trans                &kp N4                &kp N5                &kp N6                &trans                &kp END               &kp LEFT              &kp DOWN              &kp RIGHT             &trans                &kp LSHFT
                &trans                &trans                &kp N1                &kp N2                &kp N3                &trans                &none                 &none                 &none                 &none                 &kp INS               &trans                &trans                &trans                &trans                &rd 1
                &none                 &kp N0                &kp LSHFT             &none                 &none                 &none                 &none                 &kp KP_DOT            &lt NUM BSPC          &trans
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        func_layer {
            display-name = "Function + media";
            bindings = <
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
                &kp F1                &kp F2                &kp F3                &kp F4                &kp F5                &kp F6                &none                 &kp C_VOL_DN          &kp C_VOL_UP          &kp C_MUTE            &none                 &kp LALT
                &kp F7                &kp F8                &kp F9                &kp F10               &kp F11               &kp F12               &none                 &kp C_PREV            &kp C_PLAY_PAUSE      &kp C_NEXT            &none                 &mo ADJUST
                &kp F13               &kp F14               &kp F15               &kp F16               &kp F17               &kp F18               &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &kp LCTRL
                &none                 &trans                &trans                &none                 &none                 &none                 &none                 &none                 &trans                &trans
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
                &none                 &none                 &none                 &none                 &none                 &none                 &base_select QWERTY   &base_select COLEMAK  &base_select FPS      &tog DJMAX            &none                 &none
                &none                 &none                 &none                 &none                 &none                 &none                 &sys_reset            &none                 &none                 &none                 &none                 &none
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &bootloader           &none                 &none                 &none                 &none                 &none
                &none                 &trans                &trans                &none                 &none                 &none                 &none                 &none                 &trans                &trans
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        djmax_layer {
            display-name = "Djmax";
            bindings = <
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
                &kp ESC               &kp Q                 &kp W                 &kp E                 &kp R                 &kp T                 &kp UP                &kp U                 &kp I                 &kp LSHFT             &kp RSHFT             &tog DJMAX
                &kp TAB               &kp A                 &kp S                 &kp D                 &kp F                 &kp G                 &kp DOWN              &kp J                 &kp K                 &kp L                 &kp SEMI              &lt NUM BSPC
                &rd 2                 &kp Z                 &kp X                 &kp C                 &kp V                 &kp B                 &none                 &none                 &none                 &none                 &kp LEFT              &kp RIGHT             &kp PG_UP             &kp PG_DN             &kp F1                &kp RET
                &none                 &kp V                 &kp B                 &none                 &none                 &none                 &none                 &kp SPACE             &kp N                 &kp F2
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
